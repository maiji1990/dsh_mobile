* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.jar binary
*.aar binary
*.png binary
# Guest-side scripts run inside the Linux sandbox
native/native-bridge/src/main/guest-assets/** text eol=lf
# Layer-archive parity fixtures (tooling/gen-layer-fixtures.py): byte-exact, never EOL-converted
tests/TestVectors/layers/** binary
tests/TestVectors/bundles/** binary
# Vendored third-party web assets: byte-exact (SHA-256 pinned in tooling/terminal-web.lock.json)
src/DshMobile.Android/Assets/terminal/vendor/** -text
