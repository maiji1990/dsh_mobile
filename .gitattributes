* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.jar binary
*.aar binary
*.png binary
# Guest-side scripts run inside the Linux sandbox
src/DshMobile.Runtime/Automation/Assets/** text eol=lf
src/DshMobile.Runtime/Guest/Assets/** text eol=lf
tests/guest/** text eol=lf
# APK assets vendored from DSHBox v1.5.1 (byte-exact; SHA-256 pinned in src/DshMobile.Android/Assets/README.md)
src/DshMobile.Android/Assets/dshbox/** -text
src/DshMobile.Android/Assets/toolchain-cache/** -text
native/link-shim/** -text
# Layer-archive parity fixtures (tooling/gen-layer-fixtures.py): byte-exact, never EOL-converted
tests/TestVectors/layers/** binary
tests/TestVectors/bundles/** binary
# Vendored third-party web assets: byte-exact (SHA-256 pinned in tooling/terminal-web.lock.json)
src/DshMobile.Android/Assets/terminal/vendor/** -text
# Guest-visible Relay assets copied from DSHBox (byte-exact: their SHA-256 is in the published version.json marker)
src/DshMobile.Runtime/Automation/Relay/Transport/Assets/** -text
tests/TestVectors/relay-guest/** -text
