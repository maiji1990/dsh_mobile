<Project Sdk="Microsoft.NET.Sdk">
  <!-- ApplicationId / ApplicationDisplayVersion / derived versionCode (ADR-0023). -->
  <Import Project="PackageIdentity.props" />
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <!-- Matches DSHBox / Interlock Relay minSdk 29 (plan section 0). -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>DshMobile.App</RootNamespace>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- .NET 11 Android defaults to CoreCLR. Do not set UseMonoRuntime / RunAOTCompilation (ADR-0001). -->
    <PublishAot>false</PublishAot>
    <TrimMode>full</TrimMode>
    <!--
      Diagnostic build only (docs/STARTUP_EXPERIMENTS.md): dotnet build -p:DshDiagnostics=true adds DSH_DIAGNOSTICS, which
      compiles the E1-E4 experiment screen. A normal Release build has no such entry.
    -->
    <DefineConstants Condition="'$(DshDiagnostics)' == 'true'">$(DefineConstants);DSH_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <!--
    Runtime assets from this repository's pinned immutable Releases (runtime-bundle/fetch-runtime.ps1 -> artifacts/runtime/).
    Packaged as assets/runtime/* (android-side only, stored uncompressed — already zstd). The DSH layer is no longer
    bundled with the APK (ADR-0027): it is imported on the device (runtime.import.dsh) or updated online.
  -->
  <PropertyGroup>
    <RuntimeAssetsDir>$(RepoRoot)artifacts\runtime\android-assets\runtime\</RuntimeAssetsDir>
    <AndroidStoreUncompressedFileExtensions>$(AndroidStoreUncompressedFileExtensions);.zst</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(RuntimeAssetsDir)android-side.tar.zst') And Exists('$(RuntimeAssetsDir)android-side.tar.zst.sha256')">
    <AndroidAsset Include="$(RuntimeAssetsDir)android-side.tar.zst;$(RuntimeAssetsDir)android-side.tar.zst.sha256" LogicalName="runtime/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="DshWarnMissingRuntimeAssets" BeforeTargets="PrepareForBuild" Condition="!Exists('$(RuntimeAssetsDir)android-side.tar.zst') Or !Exists('$(RuntimeAssetsDir)android-side.tar.zst.sha256')">
    <Warning Text="Runtime layers not staged ($(RuntimeAssetsDir)); the APK will not contain android-side. Run: pwsh runtime-bundle/fetch-runtime.ps1" />
  </Target>

  <!--
    ADR-0007 minimal native layer: libdshmobile_native.so built from native/dshmobile-native/src (own source, NDK,
    16 KB aligned) by native/build-native.*. Loaded by DshMobile.Native's P/Invoke (PTY spawn / resize / wait / kill).
  -->
  <PropertyGroup>
    <DshNativeDir>$(MSBuildThisFileDirectory)..\..\artifacts\native\dshmobile-native\</DshNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="$(DshNativeDir)arm64-v8a\libdshmobile_native.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(DshNativeDir)x86_64\libdshmobile_native.so" Abi="x86_64" />
  </ItemGroup>
  <Target Name="DshRequireNativeLibrary" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DshNativeDir)arm64-v8a\libdshmobile_native.so') Or !Exists('$(DshNativeDir)x86_64\libdshmobile_native.so')"
           Text="libdshmobile_native.so not built ($(DshNativeDir)). Run: pwsh native/build-native.ps1 (or native/dshmobile-native/build.ps1 alone)" />
  </Target>

  <!--
    ADR-0014: PRoot / loader / talloc / shmem built in this repo from pinned upstream sources (native/proot, same file
    names and NEEDED layout as DSHBox). The only PRoot source since PR-10 (ADR-0018).
  -->
  <PropertyGroup>
    <DshProotDir>$(NativeArtifactsDir)proot\</DshProotDir>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="$(DshProotDir)arm64-v8a\*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(DshProotDir)x86_64\*.so" Abi="x86_64" />
  </ItemGroup>
  <Target Name="DshRequireProot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DshProotDir)SHA256SUMS') Or !Exists('$(DshProotDir)arm64-v8a\libproot.so') Or !Exists('$(DshProotDir)arm64-v8a\libproot-loader.so') Or !Exists('$(DshProotDir)x86_64\libproot.so')"
           Text="PRoot not built in $(DshProotDir). Run: pwsh native/build-native.ps1 (or native/proot/build.ps1 alone)" />
  </Target>

  <!--
    Guest files (link shim built in native/link-shim, link-shim.mjs and the offline corepack cache from DSHBox v1.5.1;
    Assets/README.md has the provenance and hashes). The link shim is a guest (aarch64 glibc) library copied into the sandbox, not an app native
    library, so it must stay an asset. The README itself is not an asset.
  -->
  <ItemGroup>
    <AndroidNativeLibrary Remove="Assets\**\*.so" />
    <AndroidAsset Remove="Assets\README.md" />
  </ItemGroup>

  <!--
    ADR-0009: the Shizuku user service runs in a shell-uid app_process with no .NET runtime, so its remote half is a
    small in-repo Java class (translated from DSHBox RelayShellService.kt, GPL-3.0, docs/UPSTREAMS.md). Compiled into
    the APK's dex; kept from shrinking because Shizuku instantiates it by name.
  -->
  <ItemGroup>
    <AndroidJavaSource Include="Java\**\*.java" />
    <ProguardConfiguration Include="relay-shell.pro" />
  </ItemGroup>

  <!--
    Shizuku client (MIT, Maven Central, exact version): a direct dependency of the app since the C# Relay's Shizuku
    backend (AndroidShizuku / ShizukuClient, ADR-0009) and the user service above use it (ADR-0017; it used to arrive as
    a transitive export of the DSHBox Gradle build). Not bound: C# reaches it through JNI by class name.
  -->
  <ItemGroup>
    <AndroidMavenLibrary Include="dev.rikka.shizuku:api" Version="13.1.5" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:provider" Version="13.1.5" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:shared" Version="13.1.5" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:aidl" Version="13.1.5" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DshMobile.Core\DshMobile.Core.csproj" />
    <!-- C#-first layers (ADR-0007). -->
    <ProjectReference Include="..\DshMobile.Application\DshMobile.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Concrete container for the composition root (the abstractions are in-box). Trim/AOT safe for ctor/factory registrations. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Material 3 for C#-written screens (AGENTS.md rule 12); brings AndroidX AppCompat. Published 2026-07-29. -->
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <!-- vNext PR-09 Files list. Already a dependency of Material 1.14.0.6 at exactly this version; referenced so the use is explicit. -->
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
    <!-- Satisfies the Shizuku AARs' androidx.annotation dependency (XA4242); the version Material already resolves. -->
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.11.0" />
  </ItemGroup>
</Project>
