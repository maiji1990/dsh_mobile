<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    App-wide Material 3 theme (AGENTS.md rule 12, ADR-0021): light / dark follows the system (DayNight), brand colour
    roles from colors.xml, replaced by wallpaper-based dynamic colour on Android 12+ (DshMobileApplication). Windows are
    edge-to-edge; every screen pads itself with the system-bar and keyboard insets (Ui/EdgeToEdge).
  -->
  <style name="Theme.DshMobile" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/dshm_primary</item>
    <item name="colorOnPrimary">@color/dshm_on_primary</item>
    <item name="colorPrimaryContainer">@color/dshm_primary_container</item>
    <item name="colorOnPrimaryContainer">@color/dshm_on_primary_container</item>
    <item name="colorSecondary">@color/dshm_secondary</item>
    <item name="colorOnSecondary">@color/dshm_on_secondary</item>
    <item name="colorSecondaryContainer">@color/dshm_secondary_container</item>
    <item name="colorOnSecondaryContainer">@color/dshm_on_secondary_container</item>
    <item name="colorTertiary">@color/dshm_tertiary</item>
    <item name="colorOnTertiary">@color/dshm_on_tertiary</item>
    <item name="colorTertiaryContainer">@color/dshm_tertiary_container</item>
    <item name="colorOnTertiaryContainer">@color/dshm_on_tertiary_container</item>
    <item name="colorError">@color/dshm_error</item>
    <item name="colorOnError">@color/dshm_on_error</item>
    <item name="colorErrorContainer">@color/dshm_error_container</item>
    <item name="colorOnErrorContainer">@color/dshm_on_error_container</item>
    <item name="android:colorBackground">@color/dshm_background</item>
    <item name="colorOnBackground">@color/dshm_on_background</item>
    <item name="colorSurface">@color/dshm_surface</item>
    <item name="colorOnSurface">@color/dshm_on_surface</item>
    <item name="colorSurfaceVariant">@color/dshm_surface_variant</item>
    <item name="colorOnSurfaceVariant">@color/dshm_on_surface_variant</item>
    <item name="colorOutline">@color/dshm_outline</item>
    <item name="colorOutlineVariant">@color/dshm_outline_variant</item>
    <item name="colorSurfaceInverse">@color/dshm_inverse_surface</item>
    <item name="colorOnSurfaceInverse">@color/dshm_inverse_on_surface</item>
    <item name="colorPrimaryInverse">@color/dshm_inverse_primary</item>
    <item name="colorSurfaceDim">@color/dshm_surface_dim</item>
    <item name="colorSurfaceBright">@color/dshm_surface_bright</item>
    <item name="colorSurfaceContainerLowest">@color/dshm_surface_container_lowest</item>
    <item name="colorSurfaceContainerLow">@color/dshm_surface_container_low</item>
    <item name="colorSurfaceContainer">@color/dshm_surface_container</item>
    <item name="colorSurfaceContainerHigh">@color/dshm_surface_container_high</item>
    <item name="colorSurfaceContainerHighest">@color/dshm_surface_container_highest</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">@bool/dshm_light_bars</item>
    <item name="android:windowLightNavigationBar">@bool/dshm_light_bars</item>
    <item name="android:enforceNavigationBarContrast">false</item>
    <item name="android:enforceStatusBarContrast">false</item>
  </style>

  <!-- UI-S4 模型选择器等 BottomSheetDialogFragment 的统一 28dp 顶部圆角 -->
  <style name="ShapeAppearanceOverlay.DshMobile.Sheet" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSizeTopLeft">@dimen/dshm_radius_sheet</item>
    <item name="cornerSizeTopRight">@dimen/dshm_radius_sheet</item>
    <item name="cornerSizeBottomLeft">0dp</item>
    <item name="cornerSizeBottomRight">0dp</item>
  </style>

  <style name="Widget.DshMobile.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
    <item name="shapeAppearance">@style/ShapeAppearanceOverlay.DshMobile.Sheet</item>
    <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.DshMobile.Sheet</item>
  </style>

  <style name="ThemeOverlay.DshMobile.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.DshMobile.BottomSheet.Modal</item>
  </style>

  <!-- 用户消息气泡：20dp 圆角 + 右下 6dp 微收的非对称尾角（UI-S1） -->
  <style name="ShapeAppearanceOverlay.DshMobile.UserBubble" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSizeTopLeft">@dimen/dshm_radius_bubble</item>
    <item name="cornerSizeTopRight">@dimen/dshm_radius_bubble</item>
    <item name="cornerSizeBottomLeft">@dimen/dshm_radius_bubble</item>
    <item name="cornerSizeBottomRight">6dp</item>
  </style>

  <!-- Section heading above a group of rows or cards. -->
  <style name="Widget.DshMobile.SectionHeader" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingStart">16dp</item>
    <item name="android:paddingEnd">16dp</item>
    <item name="android:paddingTop">24dp</item>
    <item name="android:paddingBottom">8dp</item>
    <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    <item name="android:textColor">?attr/colorPrimary</item>
    <item name="android:accessibilityHeading">true</item>
  </style>

  <!-- Top app bar of every screen. -->
  <style name="Widget.DshMobile.Toolbar" parent="Widget.Material3.Toolbar.Surface">
    <item name="navigationIconTint">?attr/colorOnSurface</item>
  </style>

  <!-- AppBarLayout with M3 tonal lift-on-scroll to separate scrolled content cleanly. -->
  <style name="Widget.DshMobile.AppBar" parent="Widget.Material3.AppBarLayout">
    <item name="android:background">?attr/colorSurface</item>
    <item name="liftOnScroll">true</item>
  </style>

  <!-- Toolbar nested inside AppBarLayout (transparent so AppBarLayout liftOnScroll tint shows through). -->
  <style name="Widget.DshMobile.Toolbar.InAppBar" parent="Widget.Material3.Toolbar">
    <item name="android:background">@android:color/transparent</item>
    <item name="navigationIconTint">?attr/colorOnSurface</item>
    <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
  </style>

  <!-- Monospace output (command results, keys, logs), selectable. -->
  <style name="Widget.DshMobile.Mono" parent="">
    <item name="android:fontFamily">monospace</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textIsSelectable">true</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
  </style>

  <!-- Non-selectable monospace summary inside RecyclerView items (avoids clipped lines with maxLines). -->
  <style name="Widget.DshMobile.Mono.Static" parent="">
    <item name="android:fontFamily">monospace</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textIsSelectable">false</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
  </style>

  <!-- Unified pill search / filter field across Chats, Workspace and Plugins. -->
  <style name="Widget.DshMobile.SearchField" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
    <item name="boxBackgroundColor">?attr/colorSurfaceContainerLow</item>
    <item name="boxCornerRadiusTopStart">@dimen/dshm_search_corner_radius</item>
    <item name="boxCornerRadiusTopEnd">@dimen/dshm_search_corner_radius</item>
    <item name="boxCornerRadiusBottomStart">@dimen/dshm_search_corner_radius</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/dshm_search_corner_radius</item>
    <item name="boxStrokeColor">?attr/colorOutlineVariant</item>
    <item name="boxStrokeWidth">0.5dp</item>
    <item name="boxStrokeWidthFocused">1.5dp</item>
    <item name="startIconDrawable">@drawable/ic_search</item>
    <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    <item name="endIconMode">clear_text</item>
  </style>

  <!-- Card that groups a screen's content (status, settings group, form). -->
  <style name="Widget.DshMobile.Card" parent="Widget.Material3.CardView.Filled">
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
  </style>

  <!-- Grouped settings / feature card with subtle dark-mode stroke separation. -->
  <style name="Widget.DshMobile.Card.Group" parent="Widget.Material3.CardView.Filled">
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    <item name="cardCornerRadius">@dimen/dshm_card_corner_radius</item>
    <item name="strokeColor">?attr/colorOutlineVariant</item>
    <item name="strokeWidth">@dimen/dshm_card_stroke_width</item>
  </style>

  <!-- Compact pill badges for status indicators. -->
  <style name="Widget.DshMobile.Badge" parent="">
    <item name="android:background">@drawable/bg_status_pill</item>
    <item name="android:paddingStart">8dp</item>
    <item name="android:paddingEnd">8dp</item>
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">2dp</item>
    <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
    <item name="android:maxLines">1</item>
  </style>

  <style name="Widget.DshMobile.Badge.Neutral" parent="Widget.DshMobile.Badge">
    <item name="android:backgroundTint">?attr/colorSurfaceContainerHigh</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
  </style>

  <style name="Widget.DshMobile.Badge.Primary" parent="Widget.DshMobile.Badge">
    <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
    <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
  </style>

  <style name="Widget.DshMobile.Badge.Success" parent="Widget.DshMobile.Badge">
    <item name="android:backgroundTint">?attr/colorSecondaryContainer</item>
    <item name="android:textColor">@color/dshm_running</item>
  </style>

  <style name="Widget.DshMobile.Badge.Warning" parent="Widget.DshMobile.Badge">
    <item name="android:backgroundTint">?attr/colorTertiaryContainer</item>
    <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
  </style>

  <style name="Widget.DshMobile.Badge.Error" parent="Widget.DshMobile.Badge">
    <item name="android:backgroundTint">?attr/colorErrorContainer</item>
    <item name="android:textColor">?attr/colorOnErrorContainer</item>
  </style>
</resources>
