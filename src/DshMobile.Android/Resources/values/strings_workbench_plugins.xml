    <!-- 完整 WebUI 兼容模式与应用内浏览器（Custom Tabs）安全确认弹窗 -->
    <string name="plugins_webui_compat_enable_title">开启完整 WebUI 兼容模式？</string>
    <string name="plugins_webui_compat_enable_msg">开启并重启 DSH 后，将加载官方浏览器前端与页面扩展模块，使 dsh.client 页面修改类插件在应用内浏览器中完整生效。\n\n该模式会增加一定的内存占用与启动耗时；随时可在插件页顶栏菜单切回精简原生模式。</string>
    <string name="plugins_webui_compat_enable_confirm">开启并重启 DSH</string>
    <string name="plugins_webui_compat_enable_start_confirm">开启并启动 DSH</string>
    <string name="plugins_webui_compat_disable_title">切回精简原生模式？</string>
    <string name="plugins_webui_compat_disable_msg">关闭完整 WebUI 兼容模式并重启 DSH 后，将重新裁剪浏览器前端模块以降低内存占用并加快启动；应用内浏览器中已打开的本机 WebUI 会话将立即失效。</string>
    <string name="plugins_webui_compat_disable_confirm">关闭并重启 DSH</string>
    <string name="plugins_webui_compat_disable_saved">已关闭完整 WebUI 兼容模式，下次启动 DSH 时生效</string>
    <string name="plugins_webui_browser_confirm_title">在应用内浏览器（Custom Tabs）中打开完整 WebUI？</string>
    <string name="plugins_webui_browser_confirm_msg">仅访问本机回环地址（127.0.0.1），不会经过外部网络。\n\n确认后应用内浏览器只会拿到一张短时、单次有效的回环一次性票据（nonce）；启动令牌与登录 Cookie 由应用进程内的一次性票据安全回环代理兑换并持有，绝不经 URL 暴露启动令牌，也不写入日志、剪贴板或持久化存储。停止 DSH 或切回精简原生模式后票据立即失效。</string>
    <string name="plugins_webui_browser_confirm_open">安全打开</string>
