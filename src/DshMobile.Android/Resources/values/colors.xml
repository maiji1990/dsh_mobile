<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH Mobile 原创视觉体系（深海靛蓝 DeepSeek Cobalt · 稳固工作台，浅色）。
  冷静微蓝石板白画布 + DeepSeek 靛蓝主品牌色 + 清晰 1dp 结构边框 + 独立语义运行绿。
  壁纸动态取色默认关闭（UiPrefs.DynamicColorEnabled），深色模式见 values-night/colors.xml。
-->
<resources>
  <!-- 品牌主色：DeepSeek 靛蓝 -->
  <color name="dshm_primary">#1D4ED8</color>
  <color name="dshm_on_primary">#FFFFFF</color>
  <color name="dshm_primary_container">#DBEAFE</color>
  <color name="dshm_on_primary_container">#1E3A8A</color>
  <!-- 次级色：冷静石板蓝灰，承担辅助容器与低强调控件 -->
  <color name="dshm_secondary">#475569</color>
  <color name="dshm_on_secondary">#FFFFFF</color>
  <color name="dshm_secondary_container">#E2E8F0</color>
  <color name="dshm_on_secondary_container">#0F172A</color>
  <!-- 三级色：柔和蓝紫，供状态过渡与辅助标签使用 -->
  <color name="dshm_tertiary">#5B4B8A</color>
  <color name="dshm_on_tertiary">#FFFFFF</color>
  <color name="dshm_tertiary_container">#EDE9FE</color>
  <color name="dshm_on_tertiary_container">#2E1065</color>
  <!-- 错误与危险操作语义色 -->
  <color name="dshm_error">#BA1A1A</color>
  <color name="dshm_on_error">#FFFFFF</color>
  <color name="dshm_error_container">#FFDAD6</color>
  <color name="dshm_on_error_container">#410002</color>
  <!-- 冷静微蓝石板白画布与高对比深靛墨文本 -->
  <color name="dshm_background">#F5F7FB</color>
  <color name="dshm_on_background">#0F172A</color>
  <color name="dshm_surface">#F5F7FB</color>
  <color name="dshm_on_surface">#0F172A</color>
  <color name="dshm_surface_variant">#E4EBF5</color>
  <color name="dshm_on_surface_variant">#475569</color>
  <color name="dshm_outline">#64748B</color>
  <!-- 清晰精致的 1dp 结构边框 -->
  <color name="dshm_outline_variant">#D8E0EC</color>
  <color name="dshm_inverse_surface">#1E293B</color>
  <color name="dshm_inverse_on_surface">#F1F5F9</color>
  <color name="dshm_inverse_primary">#93C5FD</color>
  <color name="dshm_surface_dim">#DCE3EE</color>
  <color name="dshm_surface_bright">#FFFFFF</color>
  <!-- 表面容器层级：卡片纯白，工作台次级容器逐级微蓝 -->
  <color name="dshm_surface_container_lowest">#FFFFFF</color>
  <color name="dshm_surface_container_low">#FFFFFF</color>
  <color name="dshm_surface_container">#EEF2F8</color>
  <color name="dshm_surface_container_high">#E4EBF5</color>
  <color name="dshm_surface_container_highest">#DAE3F0</color>
  <!-- 工作区「文件 / Git」槽式切换器语义色 -->
  <color name="dshm_segment_track_bg">#E4EBF5</color>
  <color name="dshm_segment_selected_bg">#FFFFFF</color>
  <!-- 语义文本、淡靛蓝用户气泡、工程代码块 -->
  <color name="dshm_text_tertiary">#64748B</color>
  <color name="dshm_bubble_bg">#E6EEF9</color>
  <color name="dshm_code_bg">#EFF3F9</color>
  <color name="dshm_code_stroke">#D4DFEE</color>
  <!-- 8% 靛蓝选中态底色 -->
  <color name="dshm_selected_tint">#141D4ED8</color>
  <!-- 行内代码柔和底色 -->
  <color name="dshm_inline_code_bg">#0F1E3A8A</color>
  <!-- 垂直思考时间线轨道色 -->
  <color name="dshm_timeline_rail">#4064748B</color>
  <!-- 代码语法着色：浅色工作台高可读语义色 -->
  <color name="dshm_syntax_comment">#64748B</color>
  <color name="dshm_syntax_string">#15803D</color>
  <color name="dshm_syntax_keyword">#1D4ED8</color>
  <color name="dshm_syntax_number">#B45309</color>
  <color name="dshm_syntax_prompt">#1D4ED8</color>
  <color name="dshm_syntax_path">#334155</color>
  <!-- 独立语义运行绿与关注琥珀色（与主品牌靛蓝彻底分离） -->
  <color name="dshm_running">#15803D</color>
  <color name="dshm_attention">#B45309</color>
  <color name="dshm_attention_container">#FEF3C7</color>
  <color name="dshm_on_attention_container">#451A03</color>
  <!-- Diff viewer 配色（浅色） -->
  <color name="dshm_diff_add_bg">#DCFCE7</color>
  <color name="dshm_diff_add_fg">#15803D</color>
  <color name="dshm_diff_del_bg">#FEE2E2</color>
  <color name="dshm_diff_del_fg">#B91C1C</color>
  <color name="dshm_diff_hunk_bg">#DBEAFE</color>
  <color name="dshm_diff_hunk_fg">#1D4ED8</color>
  <bool name="dshm_light_bars">true</bool>
</resources>
