<?xml version="1.0" encoding="utf-8"?>
<!-- UI-S3 非模态固定审批 / 问答槽：多卡切换 + 40% 高度上限的可滚动内容 + 固定底部动作行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:filterTouchesWhenObscured="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/dshm_radius_card"
        app:strokeColor="?attr/colorOutlineVariant">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 琥珀色强调竖条：仅在需要用户介入的待处理槽出现 -->
            <View
                android:id="@+id/chat_request_slot_accent"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/dshm_attention" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <!-- 多卡堆栈切换行：仅 PendingRequests.Count > 1 时显示 -->
                <LinearLayout
                    android:id="@+id/chat_request_slot_switch_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/chat_request_slot_switch_desc"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chat_request_slot_switch_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/dshm_attention" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chat_request_slot_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/dshm_attention" />

                <!-- 中间参数 / 问题区：独立垂直滚动，最大高度在代码里限制为窗口 40% -->
                <ScrollView
                    android:id="@+id/chat_request_slot_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fillViewport="false"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/chat_request_slot_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/chat_request_slot_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/chat_request_slot_missing_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/chat_approval_missing_args"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chat_request_slot_args"
                            style="@style/Widget.DshMobile.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_notice_detail"
                            android:padding="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/chat_request_slot_questions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>

                <!-- 底部动作按钮行：固定在滚动区外，长参数永远不会把它顶出屏幕 -->
                <LinearLayout
                    android:id="@+id/chat_request_slot_approval_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_request_slot_reject"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/chat_approval_reject"
                        app:cornerRadius="@dimen/dshm_radius_block" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_request_slot_allow"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/chat_approval_allow"
                        app:cornerRadius="@dimen/dshm_radius_block" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chat_request_slot_question_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_request_slot_question_cancel"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/chat_question_cancel"
                        app:cornerRadius="@dimen/dshm_radius_block" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_request_slot_question_submit"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/chat_question_submit"
                        app:cornerRadius="@dimen/dshm_radius_block" />
                </LinearLayout>

                <!-- Hold-to-undo 撤销条：完整保留 1.5s 引擎缓冲窗的撤销入口 -->
                <LinearLayout
                    android:id="@+id/chat_request_slot_hold_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/colorSecondaryContainer"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chat_request_slot_hold_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSecondaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_request_slot_undo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_approval_undo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chat_request_slot_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
