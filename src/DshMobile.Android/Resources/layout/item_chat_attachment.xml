<?xml version="1.0" encoding="utf-8"?>
<!-- UI-S3 已选附件缩略图卡：56dp 圆角图片 + 右上角 × 删除；无缩略图时回退图标与短名 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_marginEnd="8dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="12dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="@dimen/dshm_hairline">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/chat_attachment_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/chat_attachment_fallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_image"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/chat_attachment_fallback_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_attachment_remove"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="@string/chat_attachment_remove"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        app:backgroundTint="?attr/colorSurfaceContainerHighest"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_close"
        app:iconPadding="0dp"
        app:iconSize="16dp"
        app:iconTint="?attr/colorOnSurface"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="@dimen/dshm_hairline" />
</FrameLayout>
