<?xml version="1.0" encoding="utf-8"?>
<!-- 工具分组内的单个工具步骤（UI-S2 A2）：极轻无框行，点击展开参数与输出详情 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="1dp"
    android:paddingEnd="0dp"
    android:paddingBottom="1dp">

    <!-- 步骤点击头：状态图标 + 单行人类可读摘要 + 真实耗时 -->
    <LinearLayout
        android:id="@+id/chat_tool_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/chat_tool_step_status_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_tool_step_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/chat_tool_step_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- 轻弱小箭头：提示该步骤可点击展开参数与输出详情 -->
        <ImageView
            android:id="@+id/chat_tool_step_chevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:alpha="0.65"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 展开详情：美化参数、输出（默认最多 12 行）与完整输出入口 -->
    <LinearLayout
        android:id="@+id/chat_tool_step_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="2dp"
        android:paddingEnd="0dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_tool_step_args"
            style="@style/Widget.DshMobile.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notice_detail"
            android:lineSpacingExtra="2dp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/chat_tool_step_output"
            style="@style/Widget.DshMobile.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_notice_detail"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_tool_step_full_output_btn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:text="@string/chat_tool_view_full_output"
            android:visibility="gone"
            app:icon="@drawable/ic_expand_more"
            app:iconSize="16dp" />
    </LinearLayout>
</LinearLayout>
