<?xml version="1.0" encoding="utf-8"?>
<!-- 原生插件详情、官方 settings/* 实时配置与页面扩展兼容引导工作台（ADR-0034，全 XML 零悬浮） -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plugin_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/plugin_detail_appbar"
        style="@style/Widget.DshMobile.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/plugin_detail_toolbar"
            style="@style/Widget.DshMobile.Toolbar.InAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/plugin_detail_toolbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/plugin_detail_title" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dshm_hairline"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/plugin_detail_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/plugin_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/plugin_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:paddingBottom="24dp">

            <!-- 1. 待重启横幅 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plugin_detail_restart_banner"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_refresh"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/plugins_restart_banner_msg"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnTertiaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/plugin_detail_restart_now_btn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/plugins_restart_now" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. 顶部摘要与操作卡 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plugin_detail_summary_card"
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/plugin_detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/plugin_detail_package"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/plugin_detail_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/plugin_detail_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- 静态声明的状态胶囊组（多行流式折行，避免窄屏右端裁切） -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/plugin_detail_badges_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp"
                        app:singleLine="false">

                        <TextView
                            android:id="@+id/plugin_detail_badge_runtime"
                            style="@style/Widget.DshMobile.Badge.Neutral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_protected"
                            style="@style/Widget.DshMobile.Badge.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugins_protected_badge"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_official"
                            style="@style/Widget.DshMobile.Badge.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugins_catalog_official_badge"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_installed"
                            style="@style/Widget.DshMobile.Badge.Success"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugins_catalog_installed_badge"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_configurable"
                            style="@style/Widget.DshMobile.Badge.Success"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugins_configurable_badge"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_webui"
                            style="@style/Widget.DshMobile.Badge.Warning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugin_detail_badge_webui"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_not_bundle"
                            style="@style/Widget.DshMobile.Badge.Warning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugin_detail_badge_not_bundle"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/plugin_detail_badge_trimmed"
                            style="@style/Widget.DshMobile.Badge.Error"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugin_detail_badge_trimmed"
                            android:visibility="gone" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- 元信息：作者与许可证 -->
                    <TextView
                        android:id="@+id/plugin_detail_meta_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- 合法 https 外链按钮组 -->
                    <LinearLayout
                        android:id="@+id/plugin_detail_links_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_link_homepage_btn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/plugin_detail_link_homepage"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:visibility="gone"
                            app:icon="@drawable/ic_open_in_new"
                            app:iconSize="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_link_repo_btn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/plugin_detail_link_repo"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:visibility="gone"
                            app:icon="@drawable/ic_code"
                            app:iconSize="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_link_npm_btn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/plugin_detail_link_npm"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:visibility="gone"
                            app:icon="@drawable/ic_link"
                            app:iconSize="14dp" />
                    </LinearLayout>

                    <!-- 主操作按钮行：安装 / 启停 / 卸载 -->
                    <LinearLayout
                        android:id="@+id/plugin_detail_actions_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_install_btn"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/plugins_action_install"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_toggle_btn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_uninstall_btn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugins_action_uninstall"
                            android:textColor="?attr/colorError"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/plugin_detail_install_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/plugin_detail_host_needed_install"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- 诊断 / 实时反馈条 -->
                    <TextView
                        android:id="@+id/plugin_detail_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. 页面修改插件生效引导卡（仅 HasCustomWebUi == true 时显示） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plugin_detail_webui_card"
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_extension"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/plugin_detail_webui_card_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/plugin_detail_webui_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/plugin_detail_webui_card_body"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/plugin_detail_webui_action_btn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/plugin_detail_webui_action_enable"
                        app:icon="@drawable/ic_open_in_new"
                        app:iconSize="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. 官方 settings/* 实时配置卡（已安装插件展示） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plugin_detail_config_card"
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plugin_detail_config_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/plugin_detail_config_live_badge"
                            style="@style/Widget.DshMobile.Badge.Success"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/plugin_detail_config_live_badge"
                            android:visibility="gone" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plugin_detail_config_reset_all_btn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/plugin_detail_config_reset_all"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/plugin_detail_config_readonly_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="@string/plugin_detail_config_readonly_banner"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/plugin_detail_config_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/plugin_detail_config_none"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/plugin_detail_config_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. 详情文档卡（纯托管 Markdown 原生渲染） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plugin_detail_doc_card"
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/plugin_detail_doc_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/plugin_detail_doc_origin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/plugin_detail_doc_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/plugin_detail_doc_empty"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/plugin_detail_doc_markdown_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
