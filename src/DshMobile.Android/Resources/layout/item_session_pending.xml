<?xml version="1.0" encoding="utf-8"?>
<!-- UI-S4 待你处理内联操作卡：左侧 3dp 琥珀色强调竖条 + 轻量中性底，最多在列表顶部内联 2 条。
     审批按钮统一走 InboxViewModel.ApproveOnceAsync / RejectApprovalAsync，复用 RequestsEngine 单写者安全链路。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_pending_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_attention_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/dshm_attention" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/session_pending_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/dshm_attention_container"
                android:paddingStart="7dp"
                android:paddingTop="1dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/dshm_on_attention_container" />

            <TextView
                android:id="@+id/session_pending_session"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/session_pending_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/dshm_attention" />
        </LinearLayout>

        <TextView
            android:id="@+id/session_pending_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/session_pending_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_pending_reject"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/chats_inline_reject"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_pending_approve"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/chats_inline_approve"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_pending_open"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/chats_inline_answer"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
