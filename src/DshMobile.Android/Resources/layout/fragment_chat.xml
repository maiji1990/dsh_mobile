<?xml version="1.0" encoding="utf-8"?>
<!-- UI Slice 2: 沉浸式单层顶栏 + 拇指热区融合输入面板（主标题=会话名，副标题=工作区/远程标识，模型胶囊与斜杠命令下沉底部） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/chat_appbar"
        style="@style/Widget.DshMobile.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/chat_toolbar"
            style="@style/Widget.DshMobile.Toolbar.InAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/chat_toolbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:subtitle="@string/chat_session_subtitle_default"
            app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
            app:title="@string/chat_session_default_title"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 运行时 / 连接 / Cache-First 状态横幅 -->
    <LinearLayout
        android:id="@+id/chat_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/chat_status_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/chat_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chat_status_action"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- UnknownOutcome 发送状态未确认恢复条 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chat_unknown_send_banner"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:strokeColor="?attr/colorError">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/chat_unknown_send_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_send_unknown_title"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorError" />

            <TextView
                android:id="@+id/chat_unknown_send_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/chat_send_unknown_detail"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chat_unknown_check_btn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_send_check_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chat_unknown_resend_btn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/chat_send_confirm_resend"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 冷读分页触发按钮（N-05-03） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_load_older_btn"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_load_older"
        android:visibility="gone" />

    <!-- 消息列表区 + 空状态 + 回到底部悬浮按钮 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical" />

        <include
            android:id="@+id/chat_empty"
            layout="@layout/view_empty_state"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chat_scroll_to_bottom"
            style="@style/Widget.Material3.FloatingActionButton.Small.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/chat_scroll_bottom_desc"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_arrow_downward" />
    </FrameLayout>

    <!-- 升级后斜杠命令浮层（点击 / 按钮或键入 / 时展开，支持过滤与命令说明） -->
    <include
        android:id="@+id/chat_slash_panel"
        layout="@layout/view_chat_slash_panel"
        android:visibility="gone" />

    <!-- 已选图片附件预览条 -->
    <HorizontalScrollView
        android:id="@+id/chat_attachments_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chat_attachments_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/chat_composer_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 统一双层融合胶囊输入面板（全在拇指热区） -->
    <LinearLayout
        android:id="@+id/chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chat_composer_card"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="22dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/chat_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="@string/chat_composer_hint"
                    android:imeOptions="actionSend|flagNoEnterAction|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minHeight="42dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/chat_composer_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_attach_image_btn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/chat_attach_image_desc"
                        app:icon="@drawable/ic_image"
                        app:iconSize="19dp"
                        app:iconTint="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_slash_toggle_btn"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/chat_slash_toggle_desc"
                        app:icon="@drawable/ic_code"
                        app:iconSize="19dp"
                        app:iconTint="?attr/colorOnSurfaceVariant" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_model_pill"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxWidth="176dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="34dp"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="@string/chat_model_pill_fallback"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        app:icon="@drawable/ic_expand_more"
                        app:iconGravity="end"
                        app:iconPadding="2dp"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_send_btn"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/chat_send_desc"
                        app:icon="@drawable/ic_arrow_upward"
                        app:iconSize="20dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
