<?xml version="1.0" encoding="utf-8"?>
<!--
  UI-S5：无框通栏工作区文件行（约 56dp）：透明底 + 选中态柔和 colorSecondaryContainer 高亮，
  底部 1dp hairline 左右各内缩 16dp；彻底移除此前的独立 MaterialCardView 边框套娃。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workspace_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/workspace_entry_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/workspace_entry_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/workspace_entry_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/workspace_entry_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/files_clear_selection"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />

        <ImageView
            android:id="@+id/workspace_entry_lock"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/files_protected_short"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:tint="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workspace_entry_more"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/files_item_more_desc"
            app:icon="@drawable/ic_more_horiz"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dshm_hairline"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no" />
</LinearLayout>
