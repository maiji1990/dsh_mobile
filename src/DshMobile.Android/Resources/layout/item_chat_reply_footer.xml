<?xml version="1.0" encoding="utf-8"?>
<!-- 助手 Turn 末尾 Footer（UI-S2 A2）：左侧真实耗时 / 元信息，右侧复制回复 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dshm_touch_min"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dshm_page_margin"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/dshm_page_margin"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/chat_reply_footer_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_reply_footer_copy"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dshm_touch_min"
        android:minWidth="@dimen/dshm_touch_min"
        android:text="@string/chat_reply_copy"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        app:icon="@drawable/ic_copy"
        app:iconSize="16dp" />
</LinearLayout>
