<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/more_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/more_appbar"
        style="@style/Widget.DshMobile.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScrollTargetViewId="@id/more_scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/more_toolbar"
            style="@style/Widget.DshMobile.Toolbar.InAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/more_toolbar"
            app:title="@string/more_title" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/more_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/more_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:paddingBottom="24dp">

            <!-- UI-S6：顶部压缩为单行运行摘要条（状态圆点 + 本机/远程摘要 + 紧凑控制按钮），
                 点击任意位置打开宿主快速控制抽屉，不再占用首屏大块空间。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/more_summary_strip"
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/more_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bg_live_status_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/more_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/more_status_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/more_summary_action"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/more_summary_control_desc"
                        app:icon="@drawable/ic_tune" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组 1：AI 能力与扩展 -->
            <TextView
                style="@style/Widget.DshMobile.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/more_section_features" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/more_row_credentials"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/more_row_plugins"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/more_row_automation"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/more_row_remote"
                        layout="@layout/view_setting_nav_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组 2：运行环境与性能 -->
            <TextView
                style="@style/Widget.DshMobile.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/more_section_runtime" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/more_row_runtime"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/more_row_warmup"
                        layout="@layout/view_setting_switch_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 分组 3：应用与支持（含条件显示的开发者选项入口） -->
            <TextView
                style="@style/Widget.DshMobile.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/more_section_app" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/more_row_about"
                        layout="@layout/view_setting_action_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/more_row_licenses"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/more_developer_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/more_row_developer"
                        layout="@layout/view_setting_nav_row"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
