<?xml version="1.0" encoding="utf-8"?>
<!-- SDUI 原生面板页（实验）：全静态 Material 3 布局；标签页与区块由代码绑定数据，绝不动态创建视图 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sdui_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/sdui_appbar"
        style="@style/Widget.DshMobile.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/sdui_toolbar"
            style="@style/Widget.DshMobile.Toolbar.InAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/plugin_sdui_toolbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/plugin_sdui_title" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dshm_hairline"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sdui_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- 标签页单选芯片：静态预置 8 枚，仅显示文档声明的标签数量 -->
        <HorizontalScrollView
            android:id="@+id/sdui_tab_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sdui_tab_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_0"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_1"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_2"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_3"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_4"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_5"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_6"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sdui_tab_chip_7"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:visibility="gone" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/sdui_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 顶部状态 / 错误提示横幅：默认隐藏，由代码按需显示 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sdui_feedback_banner"
            style="@style/Widget.DshMobile.Card.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dshm_page_padding_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/dshm_page_padding_horizontal"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer">

            <TextView
                android:id="@+id/sdui_feedback_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSecondaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sdui_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:paddingBottom="24dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
