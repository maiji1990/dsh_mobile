<?xml version="1.0" encoding="utf-8"?>
<!--
  UI-S5：Diff 正文单行。旧/新行号使用 tnum 等宽数字、右对齐、36dp 紧凑列宽；
  增删底色与左侧 3dp 标记条由 bg_diff_line_added / removed 提供，代码只切换资源与文字颜色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diff_line_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:minHeight="20dp"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/diff_line_old_no"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/diff_line_new_no"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/diff_line_marker"
        android:layout_width="12dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/diff_line_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textIsSelectable="true"
        android:textSize="12sp" />
</LinearLayout>
