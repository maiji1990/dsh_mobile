<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/automation_appbar"
        style="@style/Widget.DshMobile.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScrollTargetViewId="@id/automation_scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.DshMobile.Toolbar.InAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/automation_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/automation_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:paddingBottom="24dp">

            <!-- ADR-0011：手机操控页处于前台时，审批卡独占页顶槽位（与 FLAG_SECURE 联动） -->
            <FrameLayout
                android:id="@+id/automation_approval_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <!-- 说明卡：左对齐边距一致，点击展开完整审批与权限说明 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/automation_intro_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/automation_intro"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/automation_intro_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="36dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="12dp"
                        android:text="@string/automation_more" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 手机操控中继主开关卡片 -->
            <TextView
                style="@style/Widget.DshMobile.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/automation_section_status" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/automation_row_relay"
                    layout="@layout/view_setting_switch_row" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 前置权限检查清单卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/automation_row_a11y"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/automation_row_overlay"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/automation_row_lan"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/automation_row_shizuku"
                        layout="@layout/view_setting_nav_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp" />

                    <include
                        android:id="@+id/automation_row_tools"
                        layout="@layout/view_setting_action_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/automation_details_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/automation_row_details"
                        layout="@layout/view_setting_action_row"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 连接自检卡片 -->
            <TextView
                style="@style/Widget.DshMobile.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/automation_section_check" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/automation_row_selftest"
                        layout="@layout/view_setting_action_row" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/automation_output_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/automation_output_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/automation_output"
                            style="@style/Widget.DshMobile.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:maxHeight="260dp"
                            android:padding="16dp"
                            android:scrollbars="vertical" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 开发者专用执行面偏好卡片 -->
            <TextView
                android:id="@+id/automation_dev_header"
                style="@style/Widget.DshMobile.SectionHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/automation_section_developer"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/automation_dev_card"
                style="@style/Widget.DshMobile.Card.Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <include
                    android:id="@+id/automation_row_surface_pref"
                    layout="@layout/view_setting_action_row" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
