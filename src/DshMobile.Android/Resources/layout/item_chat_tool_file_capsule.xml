<?xml version="1.0" encoding="utf-8"?>
<!-- 工作区文件胶囊（UI-S2 A2）：紧凑文件名按钮 + 可选 Diff 入口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_tool_file_capsule_name"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:insetBottom="0dp"
        android:insetTop="0dp"
        android:maxLines="1"
        android:minHeight="32dp"
        android:minWidth="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:backgroundTint="?attr/colorSurfaceContainerLow"
        app:cornerRadius="@dimen/dshm_radius_block"
        app:icon="@drawable/ic_file"
        app:iconPadding="4dp"
        app:iconSize="16dp"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chat_tool_file_capsule_diff"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:insetBottom="0dp"
        android:insetTop="0dp"
        android:minHeight="32dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/chat_tool_view_diff"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        app:icon="@drawable/ic_code"
        app:iconPadding="2dp"
        app:iconSize="14dp"
        app:iconTint="?attr/colorPrimary" />
</LinearLayout>
