<?xml version="1.0" encoding="utf-8"?>
<!--
  深海靛蓝稳固工作台主壳：
  - 窄屏（<600dp）：底部常驻稳固 3 栏 BottomNavigationView（对话 | 工作区 | 设置），上方 1dp 结构分隔线；
  - 宽屏（>=600dp）：左侧常驻 NavigationRailView + 1dp 右侧分隔线，会话页启用左右双栏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/nav_rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerLow"
            android:visibility="gone"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav"
            app:menuGravity="center"
            app:paddingBottomSystemWindowInsets="false"
            app:paddingStartSystemWindowInsets="false"
            app:paddingTopSystemWindowInsets="false" />

        <View
            android:id="@+id/nav_rail_divider"
            android:layout_width="@dimen/dshm_hairline"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 全局待审批/待问答顶部实时横幅 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/main_inbox_banner"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorErrorContainer"
                app:cardCornerRadius="@dimen/dshm_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorError"
                app:strokeWidth="@dimen/dshm_hairline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_notification"
                        app:tint="?attr/colorOnErrorContainer" />

                    <TextView
                        android:id="@+id/main_inbox_banner_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnErrorContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/main_inbox_banner_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inbox_banner_action"
                        android:textColor="?attr/colorOnErrorContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 宽屏且处于 nav_chats 时启用「约 340dp 会话列表 + 1dp 分割线 + 右栏 ChatFragment」双栏；
                 窄屏或切换到文件/更多页时右栏隐藏，tab_content 恢复单栏铺满。 -->
            <LinearLayout
                android:id="@+id/main_content_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/tab_content"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/main_detail_divider"
                    android:layout_width="@dimen/dshm_hairline"
                    android:layout_height="match_parent"
                    android:background="?attr/colorOutlineVariant"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/main_detail_pane"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:visibility="gone">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/main_detail_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:id="@+id/main_detail_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chat"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/main_detail_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/chats_detail_empty_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/main_detail_empty_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/chats_detail_empty_hint"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 稳固贴底导航顶部分隔线与 3 栏底栏（窄屏常驻，宽屏隐藏，不浮空不留双重系统栏内边距） -->
    <View
        android:id="@+id/bottom_nav_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dshm_hairline"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav"
        app:paddingBottomSystemWindowInsets="false" />
</LinearLayout>
