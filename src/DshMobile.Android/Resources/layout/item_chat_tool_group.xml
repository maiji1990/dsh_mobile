<?xml version="1.0" encoding="utf-8"?>
<!-- 工具调用分组（UI-S2 A2）：无外框轻量折叠头 + 更早步骤折叠行 + 步骤列表 + 去重文件胶囊 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dshm_page_margin"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/dshm_page_margin"
    android:paddingBottom="4dp">

    <!-- 折叠汇总头：图标 + 单行摘要 + 折叠箭头，点击展开 / 收起全部步骤 -->
    <LinearLayout
        android:id="@+id/chat_tool_group_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dshm_touch_min"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/chat_tool_group_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_terminal"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_tool_group_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/chat_tool_group_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/chat_tool_toggle_desc"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 更早步骤折叠行：仅在步骤较多时由 Adapter 显示 -->
    <LinearLayout
        android:id="@+id/chat_tool_group_earlier_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_tool_group_earlier_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- 步骤列表容器：由 Adapter 逐个填充 item_chat_tool_step -->
    <LinearLayout
        android:id="@+id/chat_tool_group_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical" />

    <!-- 去重后的工作区文件胶囊区：仅在存在安全相对路径时显示 -->
    <HorizontalScrollView
        android:id="@+id/chat_tool_group_files_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chat_tool_group_files_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
