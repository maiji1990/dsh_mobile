<?xml version="1.0" encoding="utf-8"?>
<!-- 工具调用分组（Polish-P2）：18dp 单色图标 + 单行汇总 + tnum 耗时 + 贯通 1dp 时间线轨道 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dshm_page_margin"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/dshm_page_margin"
    android:paddingBottom="4dp">

    <!-- 折叠汇总头：图标 + 单行摘要 + 真实耗时 + 折叠箭头，点击展开 / 收起全部步骤 -->
    <LinearLayout
        android:id="@+id/chat_tool_group_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dshm_touch_min"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/chat_tool_group_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_terminal"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_tool_group_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.DshMobile.Secondary"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_tool_group_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/chat_tool_group_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/chat_tool_toggle_desc"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 更早步骤折叠行：保留兼容入口，当前产品行为由整组折叠头统一控制。 -->
    <LinearLayout
        android:id="@+id/chat_tool_group_earlier_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_tool_group_earlier_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- 子步骤共用一条与组头 18dp 图标中心对齐的 1dp 垂直轨道线。 -->
    <FrameLayout
        android:id="@+id/chat_tool_group_steps_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <!-- 顶部 / 底部各收进 18dp，从首颗步骤图标中心起、到末颗图标中心止，
             不再向上探进 18dp 图标边缘形成多余短线头。 -->
        <View
            android:id="@+id/chat_tool_group_rail"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:background="@color/dshm_timeline_rail" />

        <LinearLayout
            android:id="@+id/chat_tool_group_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </FrameLayout>

    <!-- 去重后的工作区文件胶囊区：仅在存在安全相对路径时显示 -->
    <HorizontalScrollView
        android:id="@+id/chat_tool_group_files_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chat_tool_group_files_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
