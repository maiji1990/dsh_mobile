<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/plugins_appbar"
        style="@style/Widget.DshMobile.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScrollTargetViewId="@id/plugins_list">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/plugins_toolbar"
            style="@style/Widget.DshMobile.Toolbar.InAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/plugins_toolbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/plugins_title" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/plugins_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 未启动 DSH 时展示明确前置提示与启动按钮 -->
        <LinearLayout
            android:id="@+id/plugins_host_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugins_host_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/plugins_host_required"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plugins_start_dsh_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/chat_status_start_dsh" />
        </LinearLayout>

        <!-- 置顶「需要重启 DSH 生效」横幅与快捷重启按钮 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/plugins_restart_banner"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dshm_page_padding_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/dshm_page_padding_horizontal"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/plugins_restart_banner_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/plugins_restart_banner_msg"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/plugins_restart_now_btn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/plugins_restart_now" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 统一胶囊搜索栏 + 静态 XML 状态筛选条 -->
        <include
            android:id="@+id/plugins_search_layout"
            layout="@layout/view_search_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dshm_page_padding_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/dshm_page_padding_horizontal" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/plugins_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/plugins_filter_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/plugins_filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/plugins_filter_manageable"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plugins_filter_manageable" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/plugins_filter_enabled"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plugins_filter_enabled" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/plugins_filter_protected"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plugins_filter_protected" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/plugins_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/plugins_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/plugins_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/dshm_page_padding_horizontal"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/dshm_page_padding_horizontal"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/plugins_install_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/plugins_action_install"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
