<?xml version="1.0" encoding="utf-8"?>
<!-- 思考过程（Polish-P2）：18dp 单色思考图标 + 展开态 1dp 极淡垂直时间线轨道 + 纯净无框正文 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dshm_page_margin"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/dshm_page_margin"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/chat_reasoning_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dshm_touch_min"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_psychology"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/chat_reasoning_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:text="@string/chat_reasoning_title"
            android:textAppearance="@style/TextAppearance.DshMobile.Label"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/chat_reasoning_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 轨道线起点与 18dp 图标中心对齐：图标中心 9dp，1dp 线落在 8dp 处。 -->
    <LinearLayout
        android:id="@+id/chat_reasoning_body_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_reasoning_body"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_reasoning_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.DshMobile.Secondary"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true" />
    </LinearLayout>
</LinearLayout>
