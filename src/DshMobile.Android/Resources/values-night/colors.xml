<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH Mobile 原创视觉体系（深海靛蓝 DeepSeek Cobalt · 稳固工作台，深色）。
  深邃午夜蓝黑画布 + 亮钴蓝主品牌色 + 精密 1dp 深蓝结构线 + 独立薄荷运行绿。
-->
<resources>
  <!-- 品牌主色：亮钴蓝，保证深邃午夜画布上的高对比度 -->
  <color name="dshm_primary">#60A5FA</color>
  <color name="dshm_on_primary">#061428</color>
  <color name="dshm_primary_container">#173058</color>
  <color name="dshm_on_primary_container">#DBEAFE</color>
  <!-- 次级色：冷静银灰蓝 -->
  <color name="dshm_secondary">#94A3B8</color>
  <color name="dshm_on_secondary">#0B1120</color>
  <color name="dshm_secondary_container">#1E293B</color>
  <color name="dshm_on_secondary_container">#E2E8F0</color>
  <!-- 三级色：深色蓝紫辅助语义 -->
  <color name="dshm_tertiary">#C4B5FD</color>
  <color name="dshm_on_tertiary">#2E1065</color>
  <color name="dshm_tertiary_container">#3B2868</color>
  <color name="dshm_on_tertiary_container">#EDE9FE</color>
  <!-- 错误与危险操作语义色 -->
  <color name="dshm_error">#FFB4AB</color>
  <color name="dshm_on_error">#690005</color>
  <color name="dshm_error_container">#93000A</color>
  <color name="dshm_on_error_container">#FFDAD6</color>
  <!-- 深邃午夜蓝黑画布 -->
  <color name="dshm_background">#0B1120</color>
  <color name="dshm_on_background">#E2E8F0</color>
  <color name="dshm_surface">#0B1120</color>
  <color name="dshm_on_surface">#E2E8F0</color>
  <color name="dshm_surface_variant">#1D2940</color>
  <color name="dshm_on_surface_variant">#94A3B8</color>
  <color name="dshm_outline">#64748B</color>
  <!-- 深色 1dp 结构边框 -->
  <color name="dshm_outline_variant">#24334C</color>
  <color name="dshm_inverse_surface">#E2E8F0</color>
  <color name="dshm_inverse_on_surface">#0F172A</color>
  <color name="dshm_inverse_primary">#1D4ED8</color>
  <color name="dshm_surface_dim">#090E1A</color>
  <color name="dshm_surface_bright">#24324D</color>
  <!-- 深色表面容器逐级抬亮 -->
  <color name="dshm_surface_container_lowest">#0B1120</color>
  <color name="dshm_surface_container_low">#111827</color>
  <color name="dshm_surface_container">#162033</color>
  <color name="dshm_surface_container_high">#1D2940</color>
  <color name="dshm_surface_container_highest">#24324D</color>
  <!-- 工作区「文件 / Git」槽式切换器语义色 -->
  <color name="dshm_segment_track_bg">#111827</color>
  <color name="dshm_segment_selected_bg">#24324D</color>
  <!-- 语义文本、深蓝用户气泡、工程代码块 -->
  <color name="dshm_text_tertiary">#94A3B8</color>
  <color name="dshm_bubble_bg">#17253D</color>
  <color name="dshm_code_bg">#0F172A</color>
  <color name="dshm_code_stroke">#1E2D45</color>
  <!-- 深色亮钴蓝选中态底色 -->
  <color name="dshm_selected_tint">#1F60A5FA</color>
  <!-- 行内代码柔和底色 -->
  <color name="dshm_inline_code_bg">#14E2E8F0</color>
  <!-- 垂直思考时间线轨道色 -->
  <color name="dshm_timeline_rail">#4094A3B8</color>
  <!-- 代码语法着色：深色午夜画布下柔和清晰 -->
  <color name="dshm_syntax_comment">#94A3B8</color>
  <color name="dshm_syntax_string">#86EFAC</color>
  <color name="dshm_syntax_keyword">#93C5FD</color>
  <color name="dshm_syntax_number">#FCD34D</color>
  <color name="dshm_syntax_prompt">#60A5FA</color>
  <color name="dshm_syntax_path">#CBD5E1</color>
  <!-- 独立语义运行绿与关注琥珀色 -->
  <color name="dshm_running">#34D399</color>
  <color name="dshm_attention">#FBBF24</color>
  <color name="dshm_attention_container">#3B2608</color>
  <color name="dshm_on_attention_container">#FDE68A</color>
  <!-- Diff viewer 配色（深色） -->
  <color name="dshm_diff_add_bg">#122B22</color>
  <color name="dshm_diff_add_fg">#6EE7B7</color>
  <color name="dshm_diff_del_bg">#38181D</color>
  <color name="dshm_diff_del_fg">#FCA5A5</color>
  <color name="dshm_diff_hunk_bg">#172B4D</color>
  <color name="dshm_diff_hunk_fg">#93C5FD</color>
  <bool name="dshm_light_bars">false</bool>
</resources>
