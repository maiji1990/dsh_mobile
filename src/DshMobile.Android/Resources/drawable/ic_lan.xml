<?xml version="1.0" encoding="utf-8"?>
<!-- Simple network glyph for ADR-0032 (own drawing, no upstream asset); tinted by the view that shows it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal"
    android:autoMirrored="false">
  <!-- top device -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M9,3h6v4h-6z" />
  <!-- stem from the top device to the bus -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M11,7h2v3h-2z" />
  <!-- bus -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M4,10h16v2h-16z" />
  <!-- stems down to both bottom devices -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M6,12h2v3h-2zM16,12h2v3h-2z" />
  <!-- bottom devices -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M3,15h8v4h-8zM13,15h8v4h-8z" />
</vector>
