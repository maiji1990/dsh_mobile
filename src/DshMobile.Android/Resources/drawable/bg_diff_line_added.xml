<?xml version="1.0" encoding="utf-8"?>
<!-- UI-S5：新增行柔和底色 + 左侧 3dp 绿色标记条（整套行背景由 XML 声明，代码只切换资源） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dshm_diff_add_bg" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/dshm_diff_add_fg" />
        </shape>
    </item>
</layer-list>
