<Project>
  <!--
    Permanent package identity (ADR-0023). Android identifies an app by package name + signing certificate: never change
    ApplicationId after a release (a new id is a different app; data does not move).

    versionCode (ApplicationVersion) is derived, never hand-edited:
      major * 1000000 + minor * 10000 + patch * 100 + build
    from ApplicationDisplayVersion "major.minor.patch" (minor, patch 0..99) and DshVersionBuild (0..99, a re-pack of the
    same version; pass -p:DshVersionBuild=N). It increases whenever the display version does, as PackageInstaller
    updates require. 0.1.0 -> 10000.
  -->
  <PropertyGroup>
    <ApplicationId>io.github.maiji1990.dshmobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <DshVersionBuild Condition="'$(DshVersionBuild)' == ''">0</DshVersionBuild>
    <_DshVersionValid>false</_DshVersionValid>
    <_DshVersionValid Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ApplicationDisplayVersion)', '^\d{1,3}\.\d{1,2}\.\d{1,2}$')) And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DshVersionBuild)', '^\d{1,2}$'))">true</_DshVersionValid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_DshVersionValid)' == 'true'">
    <_DshVersionMajor>$([System.Version]::Parse('$(ApplicationDisplayVersion)').Major)</_DshVersionMajor>
    <_DshVersionMinor>$([System.Version]::Parse('$(ApplicationDisplayVersion)').Minor)</_DshVersionMinor>
    <_DshVersionPatch>$([System.Version]::Parse('$(ApplicationDisplayVersion)').Build)</_DshVersionPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_DshVersionMajor), 1000000)), $([MSBuild]::Multiply($(_DshVersionMinor), 10000)))), $([MSBuild]::Add($([MSBuild]::Multiply($(_DshVersionPatch), 100)), $(DshVersionBuild)))))</ApplicationVersion>
  </PropertyGroup>

  <Target Name="DshCheckPackageIdentity" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(_DshVersionValid)' != 'true'"
      Text="ApplicationDisplayVersion must be major.minor.patch (minor and patch 0..99) and DshVersionBuild 0..99; got '$(ApplicationDisplayVersion)' / '$(DshVersionBuild)' (ADR-0023)." />
    <Message Importance="high" Text="DSH Mobile package $(ApplicationId) $(ApplicationDisplayVersion) versionCode $(ApplicationVersion) (ADR-0023)" />
  </Target>
</Project>
