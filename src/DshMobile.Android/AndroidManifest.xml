<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Loopback health checks + DSH's own model/API traffic (TASK-004). -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!--
    ADR-0032: Android 17 (API 37) gates local-network access behind this runtime permission for apps targeting 37+.
    Without it every LAN TCP connection from the app UID - including the PRoot guest's curl/ssh - times out, and
    `pm grant` cannot help (an undeclared permission cannot be granted). Requested from C#, never assumed.
  -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <!-- Keeps the Debian/PRoot sandbox and DSH alive while the UI is in the background (plan 6.3). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    ADR-0011: the floating approval card while the assistant works in another app. A special-access grant the user
    makes in system Settings ("display over other apps"); without it the question goes to the notification card.
  -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!--
    C# Relay capabilities (ADR-0008 / ADR-0009). Until PR-10 these came merged from the DSHBox interlock-relay-core AAR;
    since ADR-0018 the app declares them itself, the same set. Each one is a runtime or special-access grant the user
    makes in system UI; nothing is granted by the app, and every call is still gated by Relay approval. The merged
    result is checked with `aapt2 dump badging` (docs/COMPATIBILITY.md).
  -->
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.WRITE_CONTACTS" />
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- sys.intent clock entries: the system alarm / timer activities require it (normal permission, install-time). -->
  <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
  <!-- Screen capture: a MediaProjection virtual display needs a mediaProjection foreground service (Android 14+). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <!-- The short CPU-only wake lease while the channel waits for a reply with the screen off. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Required by ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (this app's own switch only). -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Shizuku backend (ADR-0009): the binder API permission the Shizuku manager grants on the user's answer. -->
  <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
  <!-- Visibility of the Shizuku manager and of launchable apps, instead of QUERY_ALL_PACKAGES. -->
  <queries>
    <package android:name="moe.shizuku.privileged.api" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <!--
    extractNativeLibs: PRoot (libproot.so / libproot-loader.so) is exec'd as a program from
    nativeLibraryDir, so the .so files must exist on disk (same as DSHBox).
  -->
  <application
      android:allowBackup="false"
      android:theme="@style/Theme.DshMobile"
      android:extractNativeLibs="true"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:label="@string/app_name"
      android:networkSecurityConfig="@xml/network_security_config"
      android:usesCleartextTraffic="false"
      android:supportsRtl="true">

    <service
        android:name="dshmobile.app.HarnessForegroundService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Runs a user-started local Linux sandbox (PRoot) hosting the DeepSeek Harness developer agent and its loopback web UI." />
    </service>

    <!--
      C# Relay (PR-07 step 4, ADR-0007/ADR-0009): this app's own services. Each one is enabled or started only by the
      user (accessibility / notification access are granted in system Settings) or by the opt-in C# Relay host.
      Exported only where the system must bind them, and then guarded by the system-only bind permission.
    -->
    <service
        android:name="dshmobile.relay.DshAccessibilityService"
        android:label="@string/relay_cs_a11y_label"
        android:exported="true"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/dsh_accessibility_service_config" />
    </service>
    <service
        android:name="dshmobile.relay.DshNotificationListener"
        android:label="@string/relay_cs_listener_label"
        android:exported="true"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <service
        android:name="dshmobile.relay.RelayCsProjectionService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection" />
    <service
        android:name="dshmobile.relay.RelayCsChannelService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Keeps the user-started on-device automation channel alive so the accessibility service is not unbound by background cleaners." />
    </service>
    <!--
      Shizuku authorization / binder provider (Shizuku client 13.1.5, MIT): authorities namespaced per application id,
      and the system-only permission keeps ordinary apps from touching it. Declared by the app since ADR-0018 (it came
      from the interlock-relay-core AAR before).
    -->
    <provider
        android:name="rikka.shizuku.ShizukuProvider"
        android:authorities="${applicationId}.shizuku"
        android:enabled="true"
        android:exported="true"
        android:multiprocess="false"
        android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
  </application>
</manifest>
