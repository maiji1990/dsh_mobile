<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!-- Loopback health checks + DSH's own model/API traffic (TASK-004). -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Keeps the Debian/PRoot sandbox and DSH alive while the UI is in the background (plan 6.3). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Browser automation (TASK-011, ADR-0005): DSHBox's browser runtime guards its command service and broadcasts
    with this app-private permission. Signature level: only this APK (same signature) can hold it.
  -->
  <permission android:name="${applicationId}.permission.BROWSER_INTERNAL" android:protectionLevel="signature" />
  <uses-permission android:name="${applicationId}.permission.BROWSER_INTERNAL" />

  <!--
    Interlock Relay core (TASK-010, ADR-0008): its manifest declares the permissions, `<queries>` and components of
    all its capabilities, and since ADR-0008 they are all merged as they come (calendar, contacts, location, media,
    microphone, alarms, screen capture, Shizuku binder, notification listener). Each permission is a runtime or
    special-access grant the user makes in system UI; nothing is granted by the app, and every call is still gated
    by Relay approval. The merged result is checked with `aapt2 dump badging` (docs/COMPATIBILITY.md).
  -->

  <!--
    extractNativeLibs: PRoot (libproot.so / libproot-loader.so) is exec'd as a program from
    nativeLibraryDir, so the .so files must exist on disk (same as DSHBox).
  -->
  <application
      android:allowBackup="false"
      android:extractNativeLibs="true"
      android:icon="@mipmap/appicon"
      android:roundIcon="@mipmap/appicon_round"
      android:label="@string/app_name"
      android:networkSecurityConfig="@xml/network_security_config"
      android:usesCleartextTraffic="false"
      android:supportsRtl="true">

    <service
        android:name="dshmobile.app.HarnessForegroundService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Runs a user-started local Linux sandbox (PRoot) hosting the DeepSeek Harness developer agent and its loopback web UI." />
    </service>
  </application>
</manifest>
