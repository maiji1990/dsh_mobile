<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Binds ONLY the DSH Mobile Java facade (dshmobile.nativebridge.*). Reused DSHBox module AARs, their
    exported Maven jars and DSHBox's prebuilt .so files ship with Bind="false" (ADR-0002): C# never sees
    DSHBox Kotlin types directly. Everything below comes from `native/build-native.ps1` -> artifacts/native/.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>DshMobile.NativeBinding</RootNamespace>
    <!-- CA1852 fires on generator-emitted invoker classes we don't own. -->
    <NoWarn>$(NoWarn);CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AndroidLibrary Include="$(NativeArtifactsDir)dsh-native-bridge-release.aar" />
    <!-- DSHBox modules (GPL-3.0, unmodified source at the pinned submodule SHA). Packaged, not bound. -->
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-common-release.aar" Bind="false" />
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-sandbox-manager-release.aar" Bind="false" />
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-dsh-renderer-api-release.aar" Bind="false" />
    <!-- Terminal: Termux emulator (libtermux.so built from source, Apache-2.0) + view, DSHBox PRoot session layer. -->
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-terminal-emulator-release.aar" Bind="false" />
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-terminal-view-release.aar" Bind="false" />
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-terminal-session-release.aar" Bind="false" />
    <!-- Non-Kotlin/AndroidX runtime jars, audited list in artifacts/native/jars/MANIFEST.txt. -->
    <AndroidLibrary Include="$(NativeArtifactsDir)jars\*.jar" Bind="false" />
    <!-- PRoot / talloc / shmem / zstd-jni prebuilt by DSHBox (licenses: third_party/dshbox/licenses). -->
    <AndroidNativeLibrary Include="$(NativeArtifactsDir)jniLibs\arm64-v8a\*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(NativeArtifactsDir)jniLibs\x86_64\*.so" Abi="x86_64" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Maven runtime deps of the AARs above that have official .NET bindings. Versions are >= what Gradle
      resolves (kotlin-stdlib 2.4.20 api 2.2, coroutines 1.9.0, core-ktx 1.15.0) and binary compatible.
      Re-audit when a DSHBox module is added (ADR-0002).
    -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.1" />
  </ItemGroup>

  <Target Name="DshVerifyNativeArtifacts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NativeArtifactsDir)dsh-native-bridge-release.aar') Or !Exists('$(NativeArtifactsDir)dshbox-sandbox-manager-release.aar') Or !Exists('$(NativeArtifactsDir)dshbox-dsh-renderer-api-release.aar') Or !Exists('$(NativeArtifactsDir)dshbox-terminal-session-release.aar') Or !Exists('$(NativeArtifactsDir)jars\MANIFEST.txt') Or !Exists('$(NativeArtifactsDir)jniLibs\arm64-v8a\libproot.so')"
           Text="Native artifacts missing or stale in $(NativeArtifactsDir). Build them first: pwsh native/build-native.ps1 (or bash native/build-native.sh)." />
  </Target>
</Project>
