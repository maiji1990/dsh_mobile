<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Binds ONLY the DSH Mobile Java facade (dshmobile.nativebridge.*). Reused DSHBox module AARs
    ship with Bind="false" (ADR-0002): C# never sees DSHBox Kotlin types directly.
    AARs come from `native/build-native.ps1` (or .sh) -> artifacts/native/.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>DshMobile.NativeBinding</RootNamespace>
    <!-- CA1852 fires on generator-emitted invoker classes we don't own. -->
    <NoWarn>$(NoWarn);CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AndroidLibrary Include="$(NativeArtifactsDir)dsh-native-bridge-release.aar" />
    <!-- DSHBox `common` (GPL-3.0, unmodified source at the pinned submodule SHA). Packaged, not bound. -->
    <AndroidLibrary Include="$(NativeArtifactsDir)dshbox-common-release.aar" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Maven runtime deps of the AARs above, mapped to NuGet bindings. Re-audit the POMs whenever a
      DSHBox module is added (ADR-0002). `common` also declares core-ktx + coroutines, but no class the
      facade loads uses them yet; add Xamarin.AndroidX.Core.Core.Ktx / Xamarin.KotlinX.Coroutines.Android
      when sandbox-manager arrives (TASK-004).
    -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
  </ItemGroup>

  <Target Name="DshVerifyNativeArtifacts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(NativeArtifactsDir)dsh-native-bridge-release.aar') Or !Exists('$(NativeArtifactsDir)dshbox-common-release.aar')"
           Text="Native AARs missing in $(NativeArtifactsDir). Build them first: pwsh native/build-native.ps1 (or bash native/build-native.sh)." />
  </Target>
</Project>
