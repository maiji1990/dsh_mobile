<Project Sdk="Microsoft.NET.Sdk">
  <!--
    C#-owned runtime (ADR-0007): layer layout and verification, PRoot lifecycle, DSH profiles, runtime state machine.
    Replaces DSHBox sandbox-manager slice by slice; the legacy bridge implementation stays available under
    DshMobile.Runtime.Legacy for shadow comparison until each slice passes on a real device.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>DshMobile.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DshMobile.Runtime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-exact guest assets copied from DSHBox (GPL-3.0; Automation/Relay/Transport/Assets/README.md, docs/UPSTREAMS.md). -->
    <EmbeddedResource Include="Automation/Relay/Transport/Assets/relay-client.cjs" LogicalName="DshMobile.Relay.relay-client.cjs" />
    <EmbeddedResource Include="Automation/Relay/Transport/Assets/relay-usage.template.md" LogicalName="DshMobile.Relay.relay-usage.template.md" />
    <!--
      This repo's own ui_* guest scripts (UiFacadeAssets), embedded from their single source until PR-10 moves them out of
      the transitional native-bridge tree (legacy still packages the same files as APK assets).
    -->
    <EmbeddedResource Include="../../native/native-bridge/src/main/guest-assets/dshmobile/ui-facade.mjs" LogicalName="DshMobile.UiTools.ui-facade.mjs" Link="Automation/Assets/ui-facade.mjs" />
    <EmbeddedResource Include="../../native/native-bridge/src/main/guest-assets/dshmobile/ui-facade-check.mjs" LogicalName="DshMobile.UiTools.ui-facade-check.mjs" Link="Automation/Assets/ui-facade-check.mjs" />
    <!-- The profile probe (GuestAssetProvisioner / DshProbe), same single source. -->
    <EmbeddedResource Include="../../native/native-bridge/src/main/guest-assets/dshmobile/dsh-probe.mjs" LogicalName="DshMobile.Guest.dsh-probe.mjs" Link="Guest/Assets/dsh-probe.mjs" />
  </ItemGroup>

  <ItemGroup>
    <!-- zstd decoder for runtime layers (.NET 11 has no in-box Zstandard). Pure managed, MIT; see docs/UPSTREAMS.md. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <!--
      C# SSH client for the remote host slice (ADR-0012). MIT; pure managed, trimmable. Its only extra runtime dependency on
      .NET 11 is BouncyCastle.Cryptography (MIT), pinned here to the version SSH.NET 2026.0.0 resolves to.
      Microsoft.Extensions.Logging.Abstractions is part of the .NET 11 shared framework and is not shipped. docs/UPSTREAMS.md.
    -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DshMobile.Core\DshMobile.Core.csproj" />
    <ProjectReference Include="..\DshMobile.Native\DshMobile.Native.csproj" />
  </ItemGroup>
</Project>
