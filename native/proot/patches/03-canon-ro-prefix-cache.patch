+/* ADR-0030: opt-in per-process read-only prefix dentry cache.
+ * Enabled only when PROOT_RO_CACHE_PREFIXES is set (colon-separated absolute
+ * guest prefixes). Symlinks are never cached so symlink escape checks always
+ * run through the original canonicalize() recursion. */
+#define RO_CACHE_MAX_PREFIXES 8
+#define RO_CACHE_BUCKETS 16384u
+#define RO_CACHE_MAX_ENTRIES 12288u
+
+/* ADR-0030: a cached "does not exist" is only safe while nothing can create the
+ * path later. PROOT_RO_CACHE_NONEXIST=0 keeps DIR/NONDIR caching and records
+ * ENOENT only for PROOT_RO_CACHE_NONEXIST_PREFIXES (strict read-only layers). */
+static int ro_cache_nonexist_state = 0; /* 0=uninitialized, 1=enabled, -1=disabled */
+static int ro_cache_nonexist_prefix_state = 0; /* 0=uninitialized, 1=list present, -1=no list */
+static char ro_cache_nonexist_prefixes[RO_CACHE_MAX_PREFIXES][PATH_MAX];
+static size_t ro_cache_nonexist_prefix_lens[RO_CACHE_MAX_PREFIXES];
+static size_t ro_cache_nonexist_prefix_count = 0;
+
+/* ADR-0030: negative caching is only safe on strictly read-only layers.
+ * With PROOT_RO_CACHE_NONEXIST=0 this optional allow-list re-enables ENOENT
+ * caching for the listed absolute prefixes only (default: none). */
+static bool ro_cache_nonexist_matches(const char *path, size_t len)
+{
+	size_t i;
+
+	if (ro_cache_nonexist_prefix_state == 0) {
+		const char *env = getenv("PROOT_RO_CACHE_NONEXIST_PREFIXES");
+		if (env != NULL && env[0] != '\0') {
+			const char *p = env;
+			while (*p != '\0' && ro_cache_nonexist_prefix_count < RO_CACHE_MAX_PREFIXES) {
+				const char *sep = strchr(p, ':');
+				size_t plen = (sep != NULL) ? (size_t) (sep - p) : strlen(p);
+				while (plen > 1 && p[plen - 1] == '/')
+					plen--;
+				if (plen >= 2 && plen < PATH_MAX && p[0] == '/') {
+					memcpy(ro_cache_nonexist_prefixes[ro_cache_nonexist_prefix_count], p, plen);
+					ro_cache_nonexist_prefixes[ro_cache_nonexist_prefix_count][plen] = '\0';
+					ro_cache_nonexist_prefix_lens[ro_cache_nonexist_prefix_count] = plen;
+					ro_cache_nonexist_prefix_count++;
+				}
+				if (sep == NULL)
+					break;
+				p = sep + 1;
+			}
+		}
+		ro_cache_nonexist_prefix_state = ro_cache_nonexist_prefix_count > 0 ? 1 : -1;
+	}
+
+	if (ro_cache_nonexist_prefix_state < 0)
+		return false;
+
+	for (i = 0; i < ro_cache_nonexist_prefix_count; i++) {
+		size_t plen = ro_cache_nonexist_prefix_lens[i];
+		if (len == plen && memcmp(path, ro_cache_nonexist_prefixes[i], plen) == 0)
+			return true;
+		if (len > plen && path[plen] == '/' && memcmp(path, ro_cache_nonexist_prefixes[i], plen) == 0)
+			return true;
+	}
+	return false;
+}
+
+static bool ro_cache_caches_nonexist(const char *path, size_t len)
+{
+	if (ro_cache_nonexist_state == 0) {
+		const char *env = getenv("PROOT_RO_CACHE_NONEXIST");
+		ro_cache_nonexist_state = (env != NULL && env[0] == '0') ? -1 : 1;
+	}
+	if (ro_cache_nonexist_state > 0)
+		return true;
+	return ro_cache_nonexist_matches(path, len);
+}
+
+typedef enum {
+	RO_ENTRY_EMPTY = 0,
+	RO_ENTRY_DIR = 1,
+	RO_ENTRY_NONDIR = 2,
+	RO_ENTRY_NONEXIST = 3,
+} RoEntryKind;
+
+typedef struct {
+	uint64_t hash;
+	uint16_t len;
+	uint8_t kind;
+	char *guest_path;
+} RoCacheEntry;
+
+static int ro_cache_init_state = 0; /* 0=uninitialized, -1=disabled, 1=enabled */
+static char ro_cache_prefixes[RO_CACHE_MAX_PREFIXES][PATH_MAX];
+static size_t ro_cache_prefix_lens[RO_CACHE_MAX_PREFIXES];
+static size_t ro_cache_prefix_count = 0;
+static RoCacheEntry *ro_cache_table = NULL;
+static uint32_t ro_cache_count = 0;
+
+static bool ro_cache_enabled(void)
+{
+	if (ro_cache_init_state != 0)
+		return ro_cache_init_state > 0;
+
+	const char *env = getenv("PROOT_RO_CACHE_PREFIXES");
+	if (env == NULL || env[0] == '\0') {
+		ro_cache_init_state = -1;
+		return false;
+	}
+
+	const char *p = env;
+	while (*p != '\0' && ro_cache_prefix_count < RO_CACHE_MAX_PREFIXES) {
+		const char *sep = strchr(p, ':');
+		size_t len = (sep != NULL) ? (size_t) (sep - p) : strlen(p);
+		while (len > 1 && p[len - 1] == '/')
+			len--;
+		if (len >= 2 && len < PATH_MAX && p[0] == '/') {
+			memcpy(ro_cache_prefixes[ro_cache_prefix_count], p, len);
+			ro_cache_prefixes[ro_cache_prefix_count][len] = '\0';
+			ro_cache_prefix_lens[ro_cache_prefix_count] = len;
+			ro_cache_prefix_count++;
+		}
+		if (sep == NULL)
+			break;
+		p = sep + 1;
+	}
+
+	if (ro_cache_prefix_count == 0) {
+		ro_cache_init_state = -1;
+		return false;
+	}
+
+	ro_cache_table = calloc(RO_CACHE_BUCKETS, sizeof(RoCacheEntry));
+	if (ro_cache_table == NULL) {
+		ro_cache_init_state = -1;
+		return false;
+	}
+
+	ro_cache_init_state = 1;
+	return true;
+}
+
+static inline bool ro_cache_extensions_safe(Tracee *tracee)
+{
+	return get_extension(tracee, fake_id0_callback) == NULL
+	    && get_extension(tracee, link2symlink_callback) == NULL
+	    && get_extension(tracee, hidden_files_callback) == NULL;
+}
+
+static inline bool ro_cache_matches_prefix(const char *path, size_t len)
+{
+	size_t i;
+	for (i = 0; i < ro_cache_prefix_count; i++) {
+		size_t plen = ro_cache_prefix_lens[i];
+		if (len == plen && memcmp(path, ro_cache_prefixes[i], plen) == 0)
+			return true;
+		if (len > plen && path[plen] == '/' && memcmp(path, ro_cache_prefixes[i], plen) == 0)
+			return true;
+	}
+	return false;
+}
+
+static inline bool ro_cache_is_clean_absolute(const char *path, size_t len)
+{
+	size_t i;
+	if (len < 2 || len >= PATH_MAX || path[0] != '/' || path[len - 1] == '/')
+		return false;
+	for (i = 0; i < len; i++) {
+		if (path[i] == '/') {
+			if (path[i + 1] == '/')
+				return false;
+			if (path[i + 1] == '.') {
+				if (path[i + 2] == '\0' || path[i + 2] == '/')
+					return false;
+				if (path[i + 2] == '.' && (path[i + 3] == '\0' || path[i + 3] == '/'))
+					return false;
+			}
+		}
+	}
+	return true;
+}
+
+static inline uint64_t ro_cache_hash(const char *path, size_t len)
+{
+	uint64_t h = 14695981039346656037ULL;
+	size_t i;
+	for (i = 0; i < len; i++) {
+		h ^= (unsigned char) path[i];
+		h *= 1099511628211ULL;
+	}
+	return h == 0 ? 1 : h;
+}
+
+static RoEntryKind ro_cache_lookup(const char *path, size_t len)
+{
+	uint64_t h = ro_cache_hash(path, len);
+	uint32_t mask = RO_CACHE_BUCKETS - 1u;
+	uint32_t slot = (uint32_t) h & mask;
+	uint32_t probe;
+	for (probe = 0; probe < RO_CACHE_BUCKETS; probe++) {
+		RoCacheEntry *e = &ro_cache_table[(slot + probe) & mask];
+		if (e->kind == RO_ENTRY_EMPTY)
+			return RO_ENTRY_EMPTY;
+		if (e->hash == h && e->len == len && memcmp(e->guest_path, path, len) == 0)
+			return (RoEntryKind) e->kind;
+	}
+	return RO_ENTRY_EMPTY;
+}
+
+static void ro_cache_insert(const char *path, size_t len, RoEntryKind kind)
+{
+	if (ro_cache_count >= RO_CACHE_MAX_ENTRIES || len >= PATH_MAX)
+		return;
+	uint64_t h = ro_cache_hash(path, len);
+	uint32_t mask = RO_CACHE_BUCKETS - 1u;
+	uint32_t slot = (uint32_t) h & mask;
+	uint32_t probe;
+	for (probe = 0; probe < RO_CACHE_BUCKETS; probe++) {
+		RoCacheEntry *e = &ro_cache_table[(slot + probe) & mask];
+		if (e->kind == RO_ENTRY_EMPTY) {
+			char *copy = malloc(len + 1);
+			if (copy == NULL)
+				return;
+			memcpy(copy, path, len);
+			copy[len] = '\0';
+			e->guest_path = copy;
+			e->hash = h;
+			e->len = (uint16_t) len;
+			e->kind = (uint8_t) kind;
+			ro_cache_count++;
+			return;
+		}
+		if (e->hash == h && e->len == len && memcmp(e->guest_path, path, len) == 0) {
+			e->kind = (uint8_t) kind;
+			return;
+		}
+	}
+}
