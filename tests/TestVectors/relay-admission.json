        "code": "E_GATE_HOST_DENIED",
        "reason": "arg \"<no-name>\" names this app itself, and the assistant cannot read or act on the host app: drop that argument or name another app",
        "retryPolicy": "safe_retry",
        "effectState": "not_started"
      }
    },
    {
