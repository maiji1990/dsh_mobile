    "args": [
      {
        "name": "fractional node id (libcore Double)",
        "capability": "ui.node",
        "args": "{\"nodeId\":1.5}",
        "expect": "nodeId must be a whole number, got 1.5 (Double)",
        "why": "Maven org.json parses decimals as BigDecimal"
      },
      {
        "name": "relative decimal (libcore Double)",
        "capability": "ui.node",
        "args": "{\"relative\":1.5}",
        "expect": "relative must be an object, got 1.5 (Double)",
        "why": "Maven org.json parses decimals as BigDecimal"
      },
      {
        "name": "null required value is the string null (libcore)",
        "capability": "ui.tap",
        "args": "{\"x\":null,\"y\":1}",
        "expect": "x must be a number, got nothing",
        "why": "Maven optString(null) is \"\", which reads as missing"
      },
      {
        "name": "first unknown key in document order (libcore LinkedHashMap)",
        "capability": "ui.node",
        "args": "{\"zzz\":1,\"aaa\":2}",
        "expect": "unknown arg: zzz — this call takes: nodeId, relative, selector",
        "why": "Maven JSONObject iterates a HashMap"
      },
      {
        "name": "array printed the libcore way (slash escaped)",
        "capability": "ui.node",
        "args": "{\"selector\":[1,\"a/b\"]}",
        "expect": "selector must be an object, got [1,\"a\\/b\"] (JSONArray)",
        "why": "Maven does not escape '/' here"
      },
      {
        "name": "array printed the libcore way (dash raw)",
        "capability": "ui.node",
        "args": "{\"selector\":[\"—\"]}",
        "expect": "selector must be an object, got [\"—\"] (JSONArray)",
        "why": "Maven escapes U+2000..U+20FF"
      }
    ]
