{
  "description": "Shared golden vectors for `dsh plugin` argv validation and POSIX quoting. Consumed by BOTH the legacy Kotlin RuntimeController (native/native-bridge PluginSpecTest) and the C# DshMobile.Runtime (PluginCommandTests). Every argv token is single-quoted; a spec such as pkg@>=1.0.0 must never reach sh unquoted (it would redirect stdout to a file named =1.0.0).",
  "quoting": [
    { "arg": "web", "quoted": "'web'" },
    { "arg": "pkg@>=1.0.0", "quoted": "'pkg@>=1.0.0'" },
    { "arg": "pkg@*", "quoted": "'pkg@*'" },
    { "arg": "it's", "quoted": "'it'\\''s'" },
    { "arg": "", "quoted": "''" },
    { "arg": "$(id)", "quoted": "'$(id)'" }
  ],
  "commands": [
    { "verb": "list", "profile": "web", "operand": null, "valid": true,
      "argv": ["plugin", "--profile", "web", "list", "--json", "--depth", "0"],
      "line": "'plugin' '--profile' 'web' 'list' '--json' '--depth' '0'" },
    { "verb": "add", "profile": "web", "operand": "pkg@>=1.0.0", "valid": true,
      "argv": ["plugin", "--profile", "web", "add", "pkg@>=1.0.0"],
      "line": "'plugin' '--profile' 'web' 'add' 'pkg@>=1.0.0'" },
    { "verb": "add", "profile": "headless", "operand": "@scope/pkg@<2", "valid": true,
      "argv": ["plugin", "--profile", "headless", "add", "@scope/pkg@<2"],
      "line": "'plugin' '--profile' 'headless' 'add' '@scope/pkg@<2'" },
    { "verb": "add", "profile": "acp", "operand": "pkg@*", "valid": true,
      "argv": ["plugin", "--profile", "acp", "add", "pkg@*"],
      "line": "'plugin' '--profile' 'acp' 'add' 'pkg@*'" },
    { "verb": "add", "profile": "sdk", "operand": "pkg@^1.2", "valid": true,
      "argv": ["plugin", "--profile", "sdk", "add", "pkg@^1.2"],
      "line": "'plugin' '--profile' 'sdk' 'add' 'pkg@^1.2'" },
    { "verb": "remove", "profile": "sdk-minimal", "operand": "@deepseek-ai/dsh-plugin-x", "valid": true,
      "argv": ["plugin", "--profile", "sdk-minimal", "remove", "@deepseek-ai/dsh-plugin-x"],
      "line": "'plugin' '--profile' 'sdk-minimal' 'remove' '@deepseek-ai/dsh-plugin-x'" },
    { "verb": "add", "profile": "web", "operand": "pkg; rm -rf /", "valid": false },
    { "verb": "add", "profile": "web", "operand": "pkg@1.0 ; id", "valid": false },
    { "verb": "add", "profile": "web", "operand": "--registry=http://evil", "valid": false },
    { "verb": "add", "profile": "web", "operand": "pkg@>=1.0.0 <2.0.0", "valid": false },
    { "verb": "add", "profile": "web", "operand": "git+https://x/y.git", "valid": false },
    { "verb": "add", "profile": "desktop", "operand": "pkg", "valid": false },
    { "verb": "add", "profile": "web; id", "operand": "pkg", "valid": false },
    { "verb": "remove", "profile": "web", "operand": "pkg@1.0.0", "valid": false },
    { "verb": "remove", "profile": "web", "operand": "pkg --global", "valid": false },
    { "verb": "install", "profile": "web", "operand": "pkg", "valid": false }
  ]
}
