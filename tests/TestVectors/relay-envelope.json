  "csharpOnly": {
    "request": [
      {
        "name": "id null is the string \"null\" (libcore)",
        "file": "null.json",
        "text": "{\"v\":1,\"id\":null,\"capability\":\"ui.snapshot\",\"args\":{}}",
        "expect": {
          "valid": {
            "id": "null",
            "sentAtMs": 0,
            "capability": "ui.snapshot",
            "args": {},
            "timeoutMs": 90000
          }
        },
        "why": "libcore optString(null) = \"null\"; Maven gives \"\""
      },
      {
        "name": "duplicate name, last one wins (libcore)",
        "file": "dup.json",
        "text": "{\"v\":1,\"id\":\"x\",\"id\":\"dup\",\"capability\":\"ui.snapshot\",\"args\":{}}",
        "expect": {
          "valid": {
            "id": "dup",
            "sentAtMs": 0,
            "capability": "ui.snapshot",
            "args": {},
            "timeoutMs": 90000
          }
        },
        "why": "Maven org.json throws on duplicate keys"
      },
      {
        "name": "version string with spaces (libcore parseDouble trims)",
        "file": "sp.json",
        "text": "{\"v\":\" 1 \",\"id\":\"sp\",\"capability\":\"ui.snapshot\",\"args\":{}}",
        "expect": {
          "valid": {
            "id": "sp",
            "sentAtMs": 0,
            "capability": "ui.snapshot",
            "args": {},
            "timeoutMs": 90000
          }
        },
        "why": "Maven stringToNumber does not trim"
      },
      {
        "name": "version string with a d suffix (Java parseDouble)",
        "file": "dsuf.json",
        "text": "{\"v\":\"1d\",\"id\":\"dsuf\",\"capability\":\"ui.snapshot\",\"args\":{}}",
        "expect": {
          "valid": {
            "id": "dsuf",
            "sentAtMs": 0,
            "capability": "ui.snapshot",
            "args": {},
            "timeoutMs": 90000
          }
        },
        "why": "Java Double.parseDouble accepts a type suffix"
      },
      {
        "name": "single quotes are not JSON",
        "file": "sq.json",
        "text": "{'v':1,'id':'sq','capability':'ui.snapshot','args':{}}",
        "expect": {
          "rejected": {
            "id": "sq",
            "code": "E_TRANSPORT_MALFORMED",
            "cause": "not an object"
          }
        },
        "why": "deliberate: C# parses strict JSON only; org.json accepts single quotes"
      },
      {
        "name": "text after the object",
        "file": "tail.json",
        "text": "{\"v\":1,\"id\":\"tail\",\"capability\":\"ui.snapshot\",\"args\":{}} x",
        "expect": {
          "rejected": {
            "id": "tail",
            "code": "E_TRANSPORT_MALFORMED",
            "cause": "not an object"
          }
        },
        "why": "deliberate: C# parses strict JSON only; org.json ignores trailing text"
      },
      {
        "name": "comment",
        "file": "cm.json",
        "text": "{\"v\":1,/*c*/\"id\":\"cm\",\"capability\":\"ui.snapshot\",\"args\":{}}",
        "expect": {
          "rejected": {
            "id": "cm",
            "code": "E_TRANSPORT_MALFORMED",
            "cause": "not an object"
          }
        },
        "why": "deliberate: C# parses strict JSON only; libcore org.json skips comments"
      }
    ]
  }
